#!/usr/bin/env bash
# agent-hook-bridge — bridges Claude Code hooks to clank + Ghostty
# Install: cp agent-hook-bridge ~/.local/bin/ && chmod +x ~/.local/bin/agent-hook-bridge
set -euo pipefail

EVENT="${1:-}"
INPUT=$(cat)
SESS=$(tmux display-message -p '#S' 2>/dev/null || echo "unknown")
WIN=$(tmux display-message -p '#W' 2>/dev/null || echo "unknown")
PTY=$(tmux display-message -p '#{pane_tty}' 2>/dev/null || echo "")
SOCK="/tmp/clank-$(id -u).sock"

sock_send() {
  if [ -S "$SOCK" ]; then
    printf '%s\n' "$1" | nc -U "$SOCK" 2>/dev/null &
  fi
}

ghostty_notify() {
  local title="$1" body="$2"
  if [ -n "$PTY" ]; then
    printf '\033Ptmux;\033\033]777;notify;%s;%s\007\033\\' "$title" "$body" > "$PTY" 2>/dev/null
    printf '\a' > "$PTY" 2>/dev/null
  fi
}

case "$EVENT" in
  submit)
    sock_send "{\"session\":\"$SESS\",\"window\":\"$WIN\",\"state\":\"running\",\"agent\":\"claude\"}"
    ;;
  notification)
    TYPE=$(printf '%s' "$INPUT" | jq -r '.notification_type // "unknown"' 2>/dev/null || echo "unknown")
    case "$TYPE" in
      idle_prompt)
        sock_send "{\"session\":\"$SESS\",\"window\":\"$WIN\",\"state\":\"done\",\"agent\":\"claude\"}"
        ghostty_notify "$SESS > $WIN" "finished"
        ;;
      permission_prompt)
        sock_send "{\"session\":\"$SESS\",\"window\":\"$WIN\",\"state\":\"waiting\",\"reason\":\"permission\",\"agent\":\"claude\"}"
        ghostty_notify "$SESS > $WIN" "needs permission"
        ;;
      *)
        sock_send "{\"session\":\"$SESS\",\"window\":\"$WIN\",\"state\":\"waiting\",\"reason\":\"$TYPE\",\"agent\":\"claude\"}"
        ghostty_notify "$SESS > $WIN" "needs attention"
        ;;
    esac
    ;;
  stop)
    sock_send "{\"session\":\"$SESS\",\"window\":\"$WIN\",\"state\":\"done\",\"agent\":\"claude\"}"
    ghostty_notify "$SESS > $WIN" "finished"
    ;;
  statusline)
    CTX=$(printf '%s' "$INPUT" | jq -r '.context_window.used_percentage // 0' 2>/dev/null || echo "0")
    MODEL=$(printf '%s' "$INPUT" | jq -r '.model.id // ""' 2>/dev/null | sed 's/claude-//' | sed 's/-[0-9]*$//')
    if [ -n "$MODEL" ] && [ "$MODEL" != "" ]; then
      sock_send "{\"session\":\"$SESS\",\"window\":\"$WIN\",\"agent\":\"claude\",\"model\":\"$MODEL\",\"context_pct\":$CTX}"
    fi
    ;;
  *)
    echo "Usage: agent-hook-bridge {submit|notification|stop|statusline}" >&2
    exit 1
    ;;
esac
